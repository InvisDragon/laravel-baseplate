{
    "name": "invisibledragon/laravel-baseplate",
    "description": "InvisibleDragon shared basis for Laravel",
    "keywords": [
        "Invisible Dragon",
        "laravel",
        "laravel-baseplate"
    ],
    "homepage": "https://github.com/invisibledragon/laravel-baseplate",
    "license": "MIT",
    "authors": [
        {
            "name": "Joe Simpson",
            "email": "joe@invisibledragonltd.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^13||^12",
        "spatie/laravel-package-tools": "^1.93",
        "web-auth/webauthn-lib": "^5.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.3",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1||^7.10.0",
        "orchestra/testbench": "^9.0.0||^10",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "spatie/laravel-data": "^4",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "InvisibleDragon\\LaravelBaseplate\\": "src/",
            "InvisibleDragon\\LaravelBaseplate\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InvisibleDragon\\LaravelBaseplate\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-laravel-baseplate --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InvisibleDragon\\LaravelBaseplate\\LaravelBaseplateServiceProvider"
            ],
            "aliases": {
                "LaravelBaseplate": "InvisibleDragon\\LaravelBaseplate\\Facades\\LaravelBaseplate"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
